package runtime

extern fn fflush(stream *byte) int
extern fn write(fd int, data string, n int64) int64
extern fn strlen(s string) int64

fn emit(s string) {
    write(2, s, strlen(s))
}

fn panicString(msg string) {
    fflush(nil)
    emit("panic: ")
    emit(msg)
    emit("\n")
    exit(2)
}

fn panicIndex(index int64, length int64) {
    panicString("index out of range [" + str(index) + "] with length " + str(length))
}

fn panicNil() {
    panicString("nil pointer dereference")
}

fn panicDiv() {
    panicString("integer divide by zero")
}
