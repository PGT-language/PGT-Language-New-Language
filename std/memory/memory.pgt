package memory

extern fn pgt_mem_copy(dst []byte, src []byte) int
extern fn pgt_mem_set(buf []byte, v byte)

fn Copy(dst []byte, src []byte) int {
    return pgt_mem_copy(dst, src)
}

fn Set(buf []byte, v byte) {
    pgt_mem_set(buf, v)
}

fn Zero(buf []byte) {
    pgt_mem_set(buf, byte(0))
}

fn KB(n int) int {
    return n * 1024
}

fn MB(n int) int {
    return n * 1024 * 1024
}
