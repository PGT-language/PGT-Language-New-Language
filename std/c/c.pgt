package c

const Version = 1

const Prelude = "#include <stdint.h>\n#include <stddef.h>\n#include <stdbool.h>\n"

fn sanitize(s string) string {
    var* out = ""
    for ch in s {
        if (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') {
            out = out + string(ch)
        } else {
            out = out + "_"
        }
    }
    return out
}

fn BlockFuncName(pkg string, n int) string {
    return "pgt_cblock_" + sanitize(pkg) + "_" + n
}

fn LineDirective(line int, file string) string {
    var* f = ""
    for ch in file {
        if ch == '\\' || ch == '"' {
            f = f + "\\"
        }
        f = f + string(ch)
    }
    return "#line " + line + " \"" + f + "\"\n"
}
