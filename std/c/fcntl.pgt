package c

extern fn pgt_c_open(path string, flags int, mode int) int

const O_RDONLY = 0
const O_WRONLY = 1
const O_RDWR = 2
const O_CREAT = 0x40
const O_EXCL = 0x80
const O_TRUNC = 0x200
const O_APPEND = 0x400
const O_NONBLOCK = 0x800
const O_CLOEXEC = 0x80000

fn Open(path string, flags int, mode int) int {
    return pgt_c_open(path, flags, mode)
}
