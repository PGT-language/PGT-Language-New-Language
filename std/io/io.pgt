package io

extern fn pgt_read_raw_line(ok *bool) string

var* atEnd = false

fn ReadLine() string {
    var* ok = false
    var* line = pgt_read_raw_line(&ok)
    atEnd = !ok
    return line
}

fn EOF() bool {
    return atEnd
}

fn ReadLines() []string {
    var* out + {[]string} = []
    var* line = ReadLine()
    while !atEnd {
        out = append(out, line)
        line = ReadLine()
    }
    return out
}

fn Prompt(text string) string {
    print(text)
    return ReadLine()
}

fn ReadInt(text string) int {
    return parseInt(Prompt(text))
}

fn ReadFloat(text string) float {
    return parseFloat(Prompt(text))
}
