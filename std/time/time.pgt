package time

extern fn pgt_time_unix() int64
extern fn pgt_time_ms() int64
extern fn pgt_clock_ms() int64
extern fn pgt_sleep_ms(ms int)
extern fn pgt_format_time(seconds int64, layout string) string

const (
    DateTime = "%Y-%m-%d %H:%M:%S"
    Date = "%Y-%m-%d"
    Clock = "%H:%M:%S"
)

fn Now() int64 {
    return pgt_time_unix()
}

fn NowMs() int64 {
    return pgt_time_ms()
}

fn Ticks() int64 {
    return pgt_clock_ms()
}

fn Since(startTicks int64) int64 {
    return pgt_clock_ms() - startTicks
}

fn Sleep(ms int) {
    pgt_sleep_ms(ms)
}

fn Format(seconds int64, layout string) string {
    return pgt_format_time(seconds, layout)
}

fn Today() string {
    return pgt_format_time(pgt_time_unix(), Date)
}

struct Stopwatch {
    start int64
}

fn StartStopwatch() Stopwatch {
    return Stopwatch{start: pgt_clock_ms()}
}

fn (s Stopwatch) ElapsedMs() int64 {
    return pgt_clock_ms() - s.start
}

fn (s *Stopwatch) Restart() {
    s.start = pgt_clock_ms()
}
