package http

#use (
    "strings"
)

struct Request {
    Method string
    URL *URL
    Proto string
    Header *Header
    Body string
    Host string
    RemoteAddr string
    ContentLength int
    RequestURI string
    pathValues map[string]string
    form *Values
}

fn (r *Request) PathValue(name string) string {
    return r.pathValues[name]
}

fn (r *Request) SetPathValue(name string, value string) {
    if r.pathValues == nil {
        r.pathValues = make(map[string]string)
    }
    r.pathValues[name] = value
}

fn (r *Request) ParseForm() {
    if r.form != nil {
        return
    }
    var* f = NewValues()
    var* ctype = r.Header.Get("Content-Type")
    if strings.HasPrefix(ctype, "application/x-www-form-urlencoded") {
        var* body = ParseQuery(r.Body)
        for k, items in body.m {
            for item in items {
                f.Add(k, item)
            }
        }
    }
    var* q = r.URL.Query()
    for k, items in q.m {
        for item in items {
            f.Add(k, item)
        }
    }
    r.form = f
}

fn (r *Request) FormValue(key string) string {
    r.ParseForm()
    return r.form.Get(key)
}

fn (r *Request) Cookie(name string) string {
    for line in r.Header.Values("Cookie") {
        for part in strings.Split(line, ";") {
            var* kv = strings.TrimSpace(part)
            var* at = strings.Index(kv, "=")
            if at > 0 && kv[:at] == name {
                return kv[at + 1:]
            }
        }
    }
    return ""
}

fn (r *Request) UserAgent() string {
    return r.Header.Get("User-Agent")
}

fn (r *Request) Referer() string {
    return r.Header.Get("Referer")
}
