package http

#use (
    "strings"
    "conv"
    "net"
)

const maxHead = 65536
const maxBody = 8388608

struct Server {
    Addr string
    Handler Handler
    listener net.Listener
    listening bool
    closed bool
}

fn splitAddr(addr string) (string, int, string) {
    var* colon = strings.LastIndex(addr, ":")
    if colon < 0 {
        return "", 0, "invalid address " + addr + ": want host:port or :port"
    }
    var* text = addr[colon + 1:]
    if !conv.IsInt(text) {
        return "", 0, "invalid port in address " + addr
    }
    return addr[:colon], conv.Atoi(text), ""
}

fn parseHeaderLines(h *Header, lines []string) {
    // RFC 9112, 5: field-line = field-name ":" OWS field-value OWS
    for i in 1..len(lines) {
        var* at = strings.Index(lines[i], ":")
        if at > 0 {
            h.Add(strings.TrimSpace(lines[i][:at]), strings.TrimSpace(lines[i][at + 1:]))
        }
    }
}

fn readRequest(conn net.Conn) (*Request, int) {
    var* raw = ""
    var* end = -1
    while end < 0 {
        var* data, err = conn.Read(4096)
        if err != "" {
            return nil, 0
        }
        raw = raw + data
        end = strings.Index(raw, "\r\n\r\n")
        if end < 0 && len(raw) > maxHead {
            return nil, StatusRequestHeaderFieldsTooLarge
        }
    }
    var* lines = strings.Split(raw[:end], "\r\n")
    // RFC 9112, 3: request-line = method SP request-target SP HTTP-version
    var* parts = strings.Split(lines[0], " ")
    if len(parts) != 3 || !strings.HasPrefix(parts[2], "HTTP/") || !strings.HasPrefix(parts[1], "/") {
        return nil, StatusBadRequest
    }
    var* target = parts[1]
    var* query = ""
    var* at = strings.Index(target, "?")
    if at >= 0 {
        query = target[at + 1:]
        target = target[:at]
    }
    var* req = &Request{Method: parts[0], Proto: parts[2], RequestURI: parts[1], RemoteAddr: conn.RemoteAddr()}
    req.URL = &URL{Path: PathUnescape(target), RawQuery: query}
    req.Header = NewHeader()
    parseHeaderLines(req.Header, lines)
    req.Host = req.Header.Get("Host")
    if req.Header.Has("Transfer-Encoding") {
        return nil, StatusNotImplemented
    }
    var* want = 0
    var* cl = req.Header.Get("Content-Length")
    if cl != "" {
        if !conv.IsInt(cl) {
            return nil, StatusBadRequest
        }
        want = conv.Atoi(cl)
    }
    if want > maxBody {
        return nil, StatusRequestEntityTooLarge
    }
    var* body = raw[end + 4:]
    while len(body) < want {
        var* data, err = conn.Read(want - len(body))
        if err != "" {
            return nil, StatusBadRequest
        }
        body = body + data
    }
    req.Body = body[:want]
    req.ContentLength = want
    return req, 0
}

fn (s *Server) handle(conn net.Conn) {
    var* req, bad = readRequest(conn)
    if req == nil {
        if bad != 0 {
            var* w = newResponse()
            Error(w, StatusText(bad), bad)
            w.finish(conn, false)
        }
        conn.Close()
        return
    }
    var* h = s.Handler
    if h == nil {
        h = DefaultServeMux
    }
    var* w = newResponse()
    h.ServeHTTP(w, req)
    w.finish(conn, req.Method == MethodHead)
    conn.Close()
}

fn (s *Server) serve() string {
    while true {
        var* conn, err = s.listener.Accept()
        if s.closed {
            return "http: Server closed"
        }
        if err != "" {
            return err
        }
        s.handle(conn)
        if s.closed {
            return "http: Server closed"
        }
    }
    return ""
}

fn (s *Server) ListenAndServe() string {
    var* addr = s.Addr
    if addr == "" {
        addr = ":80"
    }
    var* host, port, perr = splitAddr(addr)
    if perr != "" {
        return perr
    }
    var* l, err = net.Listen(host, port)
    if err != "" {
        return err
    }
    s.listener = l
    s.listening = true
    return s.serve()
}

fn (s *Server) Close() {
    s.closed = true
    if s.listening {
        s.listener.Close()
        s.listening = false
    }
}

fn ListenAndServe(addr string, h Handler) string {
    var* s = &Server{Addr: addr, Handler: h}
    return s.ListenAndServe()
}
