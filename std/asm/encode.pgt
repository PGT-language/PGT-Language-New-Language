package asm

struct Enc {
    B []byte
    Addr int
}

fn (e *Enc) Byte(v int) {
    e.B = append(e.B, byte(v & 255))
}

fn (e *Enc) Imm(v int64, n int) {
    for i in 0..n {
        e.B = append(e.B, byte((v >> int64(8 * i)) & 255))
    }
}

struct Form {
    Opc []int
    Size int
    Reg int
    RM Operand
    ForceRex bool
    HighUsed bool
    NoModRM bool
    ImmN int
    Imm int64
    NoW bool
}

fn newForm(opc []int, size int, reg int, rm Operand) Form {
    return Form{Opc: opc, Size: size, Reg: reg, RM: rm, ForceRex: false, HighUsed: false, NoModRM: false, ImmN: 0, Imm: 0, NoW: false}
}

fn fits8(v int64) bool {
    return v >= -128 && v <= 127
}

fn fits32(v int64) bool {
    return v >= -2147483648 && v <= 2147483647
}

fn immFits(v int64, size int) bool {
    switch size {
        case 8 { return v >= -128 && v <= 255 }
        case 16 { return v >= -32768 && v <= 65535 }
        case 32 { return v >= -2147483648 && v <= 4294967295 }
    }
    return fits32(v)
}

fn simm(v int64, size int) int64 {
    switch size {
        case 8 {
            if v > 127 {
                return v - 256
            }
        }
        case 16 {
            if v > 32767 {
                return v - 65536
            }
        }
        case 32 {
            if v > 2147483647 {
                return v - 4294967296
            }
        }
    }
    return v
}

fn emitMem(e *Enc, f Form) {
    var* m = f.RM
    var* regf = f.Reg & 7
    var* immN = f.ImmN
    if m.Rip {
        e.Byte((regf << 3) | 5)
        var* disp = m.Disp
        if m.Sym != "" {
            var* target = labelValue(m.Sym)
            var* end = e.Addr + len(e.B) + 4 + immN
            disp = int64(target - end) + m.Disp
        }
        if !fits32(disp) {
            fail("displacement out of range")
            return
        }
        e.Imm(disp, 4)
        return
    }
    if m.Sym != "" {
        fail("a label in a memory operand needs rip-relative addressing")
        return
    }
    if !fits32(m.Disp) {
        fail("displacement out of range")
        return
    }
    var* base = m.Base
    var* index = m.Index
    var* scale = m.Scale
    if index == 4 {
        if scale == 1 && base >= 0 && base != 4 {
            var* tmp = base
            base = index
            index = tmp
        } else {
            fail("rsp cannot be used as an index register")
            return
        }
    }
    var* ss = 0
    switch scale {
        case 2 { ss = 1 }
        case 4 { ss = 2 }
        case 8 { ss = 3 }
    }
    if base < 0 {
        if index < 0 {
            e.Byte((regf << 3) | 4)
            e.Byte(0x25)
        } else {
            e.Byte((regf << 3) | 4)
            e.Byte((ss << 6) | ((index & 7) << 3) | 5)
        }
        e.Imm(m.Disp, 4)
        return
    }
    var* mod = 2
    if m.Disp == 0 && (base & 7) != 5 {
        mod = 0
    } else if fits8(m.Disp) {
        mod = 1
    }
    if index >= 0 || (base & 7) == 4 {
        e.Byte((mod << 6) | (regf << 3) | 4)
        var* ix = 4
        if index >= 0 {
            ix = index & 7
        }
        e.Byte((ss << 6) | (ix << 3) | (base & 7))
    } else {
        e.Byte((mod << 6) | (regf << 3) | (base & 7))
    }
    if mod == 1 {
        e.Imm(m.Disp, 1)
    } else if mod == 2 {
        e.Imm(m.Disp, 4)
    }
}

fn emitForm(e *Enc, f Form) {
    if failed() {
        return
    }
    var* rex = 0x40
    var* need = false
    if f.Size == 64 && !f.NoW {
        rex = rex | 8
        need = true
    }
    if !f.NoModRM && f.Reg >= 8 {
        rex = rex | 4
        need = true
    }
    if f.RM.Kind == OpReg {
        if f.RM.Reg >= 8 {
            rex = rex | 1
            need = true
        }
    } else if f.RM.Kind == OpMem {
        if f.RM.Base >= 8 {
            rex = rex | 1
            need = true
        }
        if f.RM.Index >= 8 {
            rex = rex | 2
            need = true
        }
    }
    if f.ForceRex {
        need = true
    }
    if need && f.HighUsed {
        fail("ah, ch, dh and bh cannot be encoded with a REX prefix")
        return
    }
    if f.Size == 16 {
        e.Byte(0x66)
    }
    if need {
        e.Byte(rex)
    }
    var* n = len(f.Opc)
    for i in 0..n {
        var* b = f.Opc[i]
        if f.NoModRM && i == n - 1 {
            b = b + (f.RM.Reg & 7)
        }
        e.Byte(b)
    }
    if !f.NoModRM {
        if f.RM.Kind == OpReg {
            e.Byte(0xC0 | ((f.Reg & 7) << 3) | (f.RM.Reg & 7))
        } else {
            emitMem(e, f)
        }
    }
    if f.ImmN > 0 {
        e.Imm(f.Imm, f.ImmN)
    }
}

fn emitSimple(e *Enc, opc []int) {
    emitForm(e, Form{Opc: opc, Size: 0, Reg: 0, RM: newOperand(OpNone), ForceRex: false, HighUsed: false, NoModRM: true, ImmN: 0, Imm: 0, NoW: false})
}
