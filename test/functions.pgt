package main

#use "test/mathx"
#use "fmt"

fn square(x) {
    return x * x
}

fn add(a int, b int) int {
    return a + b
}

fn power(base int64, exp int) int64 {
    var* result int64 = 1
    for i in 0..exp {
        result *= base
    }
    return result
}

fn fib(n int) int64 {
    var* a int64 = 0
    var* b int64 = 1
    for i in 0..n {
        var* next = a + b
        a = b
        b = next
    }
    return a
}

fn collatzLength(start int) int {
    var* n = start
    var* steps = 0
    while n != 1 {
        if n % 2 == 0 {
            n /= 2
        } else {
            n = 3 * n + 1
        }
        steps++
    }
    return steps
}

fn describe(n int) {
    if n < 0 {
        fmt.Println(n, " is negative")
        return
    }
    fmt.Println(n, " is non-negative")
}

fn demoFunctions() {
    fmt.Println("square(9) with inferred int result = ", square(9))
    fmt.Println("add(2, 3)           = ", add(2, 3))
    fmt.Println("power(2, 40)        = ", power(2, 40))
    fmt.Println("fib(60)             = ", fib(60))
    fmt.Println("collatzLength(97)   = ", collatzLength(97))
    fmt.Println("recursion: mathx.Factorial(20) = ", mathx.Factorial(20))
    describe(-3)
    describe(8)
}
