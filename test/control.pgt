package main

fn grade(score int) char {
    if score >= 90 {
        return 'A'
    } else if score >= 80 {
        return 'B'
    } else if score >= 70 {
        return 'C'
    }
    return 'F'
}

fn demoControl() {
    println("if / else if / else:")
    for var* s = 95; s >= 50; s -= 15 {
        println("  score ", s, " -> ", grade(s))
    }

    println("range loop with nested loops (multiplication table):")
    for i in 1..4 {
        for j in 1..4 {
            print(i * j, "\t")
        }
        println("")
    }

    print("while loop: ")
    var* n = 5
    while n > 0 {
        print(n, " ")
        n--
    }
    println("liftoff")

    var* c = 27
    var* steps = 0
    for c != 1 {
        if c % 2 == 0 {
            c /= 2
        } else {
            c = 3 * c + 1
        }
        steps++
    }
    println("for-condition loop: collatz(27) takes ", steps, " steps")

    print("infinite loop with continue and break: ")
    var* k = 0
    for {
        k++
        if k % 2 == 0 {
            continue
        }
        if k > 9 {
            break
        }
        print(k, " ")
    }
    println("")

    var* v = 1
    if true {
        var* v = 2
        println("scopes: inner v = ", v)
    }
    println("scopes: outer v = ", v)
}
