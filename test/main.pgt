package main

#use (
    "std/memory"
    "std/fmt"
    "std/asm"
)

fn main() {
    var* a int64 = 7
    var* b int64 = 100
    asm {
        mov rax, {a}
        mov {a}, rax
        add rax, {b}
        mov {a}, rax
    }
    var& := a = malloc(free[byte] 1024)
    var& := b = malloc(free[byte] 1024)

    fmt.Println(a)
}

return 0