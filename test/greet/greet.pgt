package greet

#use "fmt"

fn line() {
    fmt.Println("----------------------------------------")
}

fn Hello() {
    line()
    fmt.Println(" PGT showcase: everything the compiler can do")
    line()
}

fn Banner(title string) {
    fmt.Println("")
    fmt.Println("=== ", title, " ===")
}

fn TEST() {
    fmt.Println("TEST")
}

fn Goodbye() {
    fmt.Println("")
    line()
    fmt.Println(" Done.")
    line()
}
