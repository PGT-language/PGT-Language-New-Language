package irgen

#use "compiler/ast"

fn (g *Gen) genBlock(block []*ast.Stmt) {
    g.pushScope()
    for s in block {
        g.genStmt(s)
        if g.failed {
            break
        }
    }
    g.popScope()
}

fn (g *Gen) genStmt(s *ast.Stmt) {
    if g.failed {
        return
    }
    switch s.Kind {
        case ast.StmtVarDecl { g.genVarDecl(s) }
        case ast.StmtMultiVarDecl { g.genMultiVarDecl(s) }
        case ast.StmtMultiAssign { g.genMultiAssign(s) }
        case ast.StmtAssign { g.genAssign(s) }
        case ast.StmtReturn { g.genReturn(s) }
        case ast.StmtDefer { g.genDefer(s) }
        case ast.StmtExpr {
            if s.Value.Kind == ast.ExprCall {
                g.genCall(s.Value, nil)
            } else {
                g.fail("expression result is unused; only calls can be statements", s.Line, s.Col)
            }
        }
        case ast.StmtIf { g.genIf(s) }
        case ast.StmtLoop { g.genLoop(s) }
        case ast.StmtForIn { g.genForIn(s) }
        case ast.StmtSwitch { g.genSwitch(s) }
        case ast.StmtBreak {
            if len(g.loops) == 0 {
                g.fail("'break' outside of a loop or switch", s.Line, s.Col)
                return
            }
            g.br(g.loops[len(g.loops) - 1].Break)
            g.startDead()
        }
        case ast.StmtContinue {
            var* target = ""
            var* i = len(g.loops) - 1
            while i >= 0 && len(target) == 0 {
                target = g.loops[i].Continue
                i--
            }
            if len(target) == 0 {
                g.fail("'continue' outside of a loop", s.Line, s.Col)
                return
            }
            g.br(target)
            g.startDead()
        }
        case ast.StmtAsm {
            g.fail("asm blocks are not supported by the self-hosted compiler yet", s.Line, s.Col)
        }
        case ast.StmtC {
            g.fail("c blocks are not supported by the self-hosted compiler yet", s.Line, s.Col)
        }
        default {
            g.fail("internal error: unknown statement", s.Line, s.Col)
        }
    }
}

fn (g *Gen) zeroedSlot(lt string, zero string) string {
    g.uniq++
    var* slot = "%defer." + g.uniq
    g.emitAlloca(slot + " = alloca " + lt)
    g.emitAlloca("store " + lt + " " + zero + ", ptr " + slot)
    return slot
}

fn (g *Gen) isStatelessExpr(e *ast.Expr) bool {
    switch e.Kind {
        case ast.ExprIntLit, ast.ExprFloatLit, ast.ExprCharLit, ast.ExprBoolLit, ast.ExprStringLit, ast.ExprNilLit {
            return true
        }
    }
    if isEmptyArrayLit(e) {
        return true
    }
    return g.isConstExpr(e)
}

fn (g *Gen) addCapture(site *DeferSite, e *ast.Expr, slot string, t *Type, isAddr bool) {
    g.ovTypes = append(g.ovTypes, t)
    site.Caps = append(site.Caps, &DeferCapture{E: e, Slot: slot, TypeIdx: len(g.ovTypes) - 1, Addr: isAddr})
}

fn (g *Gen) captureValue(site *DeferSite, e *ast.Expr) {
    if g.isStatelessExpr(e) {
        return
    }
    var* v = g.genExpr(e, nil)
    if g.failed {
        return
    }
    var* slot = g.zeroedSlot(g.llvmType(v.T), g.zeroValue(v.T))
    g.store(v.T, v.V, slot)
    g.addCapture(site, e, slot, v.T, false)
}

fn (g *Gen) genDefer(s *ast.Stmt) {
    for l in g.loops {
        if len(l.Continue) > 0 {
            g.fail("'defer' cannot be used inside a loop", s.Line, s.Col)
            return
        }
    }
    var* call = s.Value
    var* site = &DeferSite{Call: call}
    if call.Callee.Kind == ast.ExprSelector {
        var* base = call.Callee.Base
        var* isPackage = base.Kind == ast.ExprVarRef && g.lookupLocal(base.Name) == nil && !has(g.pkg.Globals, base.Name) && g.lookupPackage(base.Name) != nil
        if !isPackage {
            var* a = g.addressOf(base, false)
            if g.failed {
                return
            }
            if a.Ok && a.T.Kind == KStruct {
                var* rslot = g.zeroedSlot("ptr", "null")
                g.emit("store ptr " + a.A + ", ptr " + rslot)
                g.addCapture(site, base, rslot, a.T, true)
            } else {
                g.captureValue(site, base)
            }
        }
    }
    var* keepArgs = call.Callee.Kind == ast.ExprVarRef && call.Callee.Name == "free" && !has(g.pkg.Functions, "free")
    if !keepArgs {
        for a in call.Args {
            g.captureValue(site, a)
        }
    }
    if g.failed {
        return
    }
    var* flag = g.zeroedSlot("i1", "false")
    g.emit("store i1 true, ptr " + flag)
    site.Flag = flag
    g.defers = append(g.defers, site)
}

fn (g *Gen) emitDefers() {
    var* i = len(g.defers) - 1
    while i >= 0 {
        var* site = g.defers[i]
        var* runBB = g.newLabel("defer.run")
        var* nextBB = g.newLabel("defer.next")
        var* on = g.load(g.tt.boolT, site.Flag)
        g.condBr(on, runBB, nextBB)
        g.label(runBB)
        for c in site.Caps {
            c.E.OvSlot = c.Slot
            c.E.OvAddr = c.Addr
            c.E.OvType = c.TypeIdx
        }
        g.genCall(site.Call, nil)
        for c in site.Caps {
            c.E.OvSlot = ""
        }
        g.br(nextBB)
        g.label(nextBB)
        i--
    }
}

fn (g *Gen) genVarDecl(s *ast.Stmt) {
    if s.IsManual {
        g.fail("manual memory (var&) is not supported by the self-hosted compiler yet", s.Line, s.Col)
        return
    }
    var* ty *Type = nil
    if s.Type != nil {
        ty = g.resolveType(s.Type, false)
    }
    var* init = Value{}
    var* hasInit = false
    if s.Init != nil {
        var* v = g.genExpr(s.Init, ty)
        if g.failed {
            return
        }
        if ty != nil {
            v = g.coerce(v, ty, s.Line, s.Col, "the initializer of '" + s.Name + "'")
        } else {
            ty = v.T
        }
        init = v
        hasInit = true
    }
    if g.failed {
        return
    }
    if ty.Kind == KNil {
        g.fail("cannot infer the type of '" + s.Name + "' from nil; write its type: var* " + s.Name + " *T = nil", s.Line, s.Col)
        return
    }
    if ty.Kind == KVoid {
        g.fail("'" + s.Name + "' cannot be initialized with a call that returns nothing", s.Line, s.Col)
        return
    }
    var* initText = g.zeroValue(ty)
    if hasInit {
        initText = init.V
    }
    var* slot = g.newVarSlot(ty, s.Name)
    g.store(ty, initText, slot)
    g.declare(s.Name, &Var{Addr: slot, T: ty, IsConst: false}, s.Line, s.Col)
}

fn (g *Gen) genValueList(values []*ast.Expr, want int, hints []*Type, line int, col int) []Value {
    var* out + {[]Value} = []
    if len(values) == want {
        for i, v in values {
            var* hint *Type = nil
            if i < len(hints) {
                hint = hints[i]
            }
            out = append(out, g.genExpr(v, hint))
            if g.failed {
                return out
            }
        }
        return out
    }
    if len(values) != 1 {
        g.fail("assignment mismatch: " + want + " variables but " + len(values) + " values", line, col)
        return out
    }
    var* e = values[0]
    if e.Kind == ast.ExprCall {
        var* v = g.genCall(e, nil)
        if g.failed {
            return out
        }
        if v.T.Kind == KVoid {
            g.fail("this call does not return a value", e.Line, e.Col)
            return out
        }
        if v.T.Kind != KTuple {
            g.fail("assignment mismatch: " + want + " variables but the call returns 1 value", e.Line, e.Col)
            return out
        }
        if len(v.T.Elems) != want {
            g.fail("assignment mismatch: " + want + " variables but the call returns " + len(v.T.Elems) + " values", e.Line, e.Col)
            return out
        }
        return g.expandTuple(v)
    }
    if e.Kind == ast.ExprTypeAssert && want == 2 && !e.IsTypeKeyword {
        return g.genAssertOk(e)
    }
    if e.Kind == ast.ExprIndex && want == 2 {
        var* r = g.genMapGetOk(e)
        if g.failed {
            return out
        }
        if len(r) > 0 {
            return r
        }
    }
    g.fail("assignment mismatch: " + want + " variables but 1 value", line, col)
    return out
}

fn (g *Gen) genMultiVarDecl(s *ast.Stmt) {
    var* n = len(s.Names)
    var* vals = g.genValueList(s.Values, n, [], s.Line, s.Col)
    if g.failed {
        return
    }
    var* anyNew = false
    for name in s.Names {
        if name != "_" {
            anyNew = true
        }
    }
    if !anyNew {
        g.fail("no new variables on the left side of '='", s.Line, s.Col)
        return
    }
    for i, name in s.Names {
        if name == "_" {
            continue
        }
        var* ty = vals[i].T
        if ty.Kind == KNil {
            g.fail("cannot infer the type of '" + name + "' from nil", s.Line, s.Cols[i])
            return
        }
        if ty.Kind == KVoid || ty.Kind == KTuple {
            g.fail("'" + name + "' cannot be initialized with this value", s.Line, s.Cols[i])
            return
        }
        var* slot = g.newVarSlot(ty, name)
        g.store(ty, vals[i].V, slot)
        g.declare(name, &Var{Addr: slot, T: ty, IsConst: false}, s.Line, s.Cols[i])
    }
}

fn (g *Gen) genMultiAssign(s *ast.Stmt) {
    var* n = len(s.Targets)
    var* addrs + {[]Addr} = []
    var* hints + {[]*Type} = []
    for t in s.Targets {
        if t.Kind == ast.ExprVarRef && t.Name == "_" {
            addrs = append(addrs, Addr{})
            hints = append(hints, nil)
            continue
        }
        g.mtActive = false
        var* a = g.requireAddress(t, true)
        if g.failed {
            return
        }
        if g.mtActive {
            g.fail("multiple assignment to map elements is not supported", t.Line, t.Col)
            return
        }
        addrs = append(addrs, a)
        hints = append(hints, a.T)
    }
    var* vals = g.genValueList(s.Values, n, hints, s.Line, s.Col)
    if g.failed {
        return
    }
    var* taken + {[]Value} = []
    for i, a in addrs {
        if !a.Ok {
            taken = append(taken, vals[i])
            continue
        }
        taken = append(taken, g.coerce(vals[i], a.T, s.Line, s.Col, "assignment"))
    }
    if g.failed {
        return
    }
    for i, a in addrs {
        if a.Ok {
            g.store(a.T, taken[i].V, a.A)
        }
    }
}

fn (g *Gen) genAssign(s *ast.Stmt) {
    g.mtActive = false
    var* target = g.requireAddress(s.Target, true)
    if g.failed {
        return
    }
    if g.mtActive && s.Target.Kind != ast.ExprIndex {
        g.fail("cannot assign to a field of a map element", s.Line, s.Col)
        return
    }
    var* rhs = g.genExpr(s.Value, target.T)
    if g.failed {
        return
    }
    if s.Op == ast.AssignSet {
        rhs = g.coerce(rhs, target.T, s.Line, s.Col, "assignment")
        if g.failed {
            return
        }
        g.store(target.T, rhs.V, target.A)
        g.commitMapTarget()
        return
    }
    var* op = ast.BinAdd
    switch s.Op {
        case ast.AssignAdd { op = ast.BinAdd }
        case ast.AssignSub { op = ast.BinSub }
        case ast.AssignMul { op = ast.BinMul }
        case ast.AssignDiv { op = ast.BinDiv }
        case ast.AssignMod { op = ast.BinMod }
    }
    var* cur = Value{V: g.load(target.T, target.A), T: target.T}
    var* res = g.genArith(op, cur, rhs, s.Line, s.Col)
    if g.failed {
        return
    }
    if res.T != target.T {
        g.fail("cannot assign " + res.T.Name() + " to a value of type " + target.T.Name(), s.Line, s.Col)
        return
    }
    g.store(target.T, res.V, target.A)
    g.commitMapTarget()
}

fn (g *Gen) genMultiReturn(s *ast.Stmt) {
    var* exprs + {[]*ast.Expr} = [s.Value]
    for r in s.Rest {
        exprs = append(exprs, r)
    }
    var* elems = g.curRet.Elems
    if len(exprs) == 1 {
        if exprs[0].Kind != ast.ExprCall {
            g.fail("wrong number of return values: expected " + len(elems) + ", got 1", s.Line, s.Col)
            return
        }
        var* v = g.genCall(exprs[0], nil)
        if g.failed {
            return
        }
        if v.T != g.curRet {
            g.fail("cannot return " + v.T.Name() + " from a function returning " + g.curRet.Name(), s.Line, s.Col)
            return
        }
        g.emitDefers()
        g.emit("ret " + g.llvmType(g.curRet) + " " + v.V)
        g.startDead()
        return
    }
    if len(exprs) != len(elems) {
        g.fail("wrong number of return values: expected " + len(elems) + ", got " + len(exprs), s.Line, s.Col)
        return
    }
    var* agg = "undef"
    for i, x in exprs {
        var* v = g.coerce(g.genExpr(x, elems[i]), elems[i], x.Line, x.Col, "return")
        if g.failed {
            return
        }
        agg = g.insert(g.curRet, agg, elems[i], v.V, i)
    }
    g.emitDefers()
    g.emit("ret " + g.llvmType(g.curRet) + " " + agg)
    g.startDead()
}

fn (g *Gen) genReturn(s *ast.Stmt) {
    if g.curRet.Kind == KTuple && s.Value != nil {
        g.genMultiReturn(s)
        return
    }
    if len(s.Rest) > 0 {
        g.fail("this function returns a single value", s.Line, s.Col)
        return
    }
    if g.curRet.Kind == KVoid {
        if s.Value != nil {
            g.fail("this function does not return a value", s.Line, s.Col)
            return
        }
        g.emitDefers()
        g.emit("ret void")
    } else {
        if s.Value == nil {
            g.fail("missing return value of type " + g.curRet.Name(), s.Line, s.Col)
            return
        }
        var* v = g.genExpr(s.Value, g.curRet)
        v = g.coerce(v, g.curRet, s.Line, s.Col, "return")
        if g.failed {
            return
        }
        g.emitDefers()
        g.emit("ret " + g.llvmType(g.curRet) + " " + v.V)
    }
    g.startDead()
}

fn (g *Gen) genIf(s *ast.Stmt) {
    var* cond = g.genCond(s.Cond)
    if g.failed {
        return
    }
    var* thenBB = g.newLabel("if.then")
    var* elseBB = ""
    var* endBB = g.newLabel("if.end")
    if s.HasElse {
        elseBB = g.newLabel("if.else")
        g.condBr(cond.V, thenBB, elseBB)
    } else {
        g.condBr(cond.V, thenBB, endBB)
    }
    g.label(thenBB)
    g.genBlock(s.Then)
    g.br(endBB)
    if s.HasElse {
        g.label(elseBB)
        g.genBlock(s.Else)
        g.br(endBB)
    }
    g.label(endBB)
}

fn (g *Gen) genLoop(s *ast.Stmt) {
    g.pushScope()
    if s.InitStmt != nil {
        g.genStmt(s.InitStmt)
    }
    var* condBB = g.newLabel("loop.cond")
    var* bodyBB = g.newLabel("loop.body")
    var* postBB = g.newLabel("loop.post")
    var* endBB = g.newLabel("loop.end")
    g.br(condBB)
    g.label(condBB)
    if s.Cond != nil {
        var* cond = g.genCond(s.Cond)
        if g.failed {
            return
        }
        g.condBr(cond.V, bodyBB, endBB)
    } else {
        g.br(bodyBB)
    }
    g.label(bodyBB)
    g.loops = append(g.loops, &LoopTarget{Continue: postBB, Break: endBB})
    g.genBlock(s.Body)
    g.loops = g.loops[0:len(g.loops) - 1]
    g.br(postBB)
    g.label(postBB)
    if s.Post != nil {
        g.genStmt(s.Post)
    }
    g.br(condBB)
    g.label(endBB)
    g.popScope()
}

fn (g *Gen) genForIn(s *ast.Stmt) {
    var* condBB = g.newLabel("for.cond")
    var* bodyBB = g.newLabel("for.body")
    var* postBB = g.newLabel("for.post")
    var* endBB = g.newLabel("for.end")
    g.pushScope()
    if s.RangeEnd != nil {
        var* from = g.genExpr(s.Iterable, g.tt.intT)
        if g.failed {
            return
        }
        var* to = g.genExpr(s.RangeEnd, from.T)
        if g.failed {
            return
        }
        if !from.T.IsIntegral() || from.T.IsUnsigned() || to.T != from.T {
            g.fail("the bounds of a range must be integers of the same type", s.Line, s.Col)
            return
        }
        var* ty = from.T
        var* lt = g.llvmType(ty)
        var* slot = g.newVarSlot(ty, s.Val)
        g.store(ty, from.V, slot)
        g.declare(s.Val, &Var{Addr: slot, T: ty, IsConst: false}, s.Line, s.Col)
        g.br(condBB)
        g.label(condBB)
        var* i = g.load(ty, slot)
        var* c = g.inst("icmp slt " + lt + " " + i + ", " + to.V)
        g.condBr(c, bodyBB, endBB)
        g.label(bodyBB)
        g.loops = append(g.loops, &LoopTarget{Continue: postBB, Break: endBB})
        g.genBlock(s.Body)
        g.loops = g.loops[0:len(g.loops) - 1]
        g.br(postBB)
        g.label(postBB)
        var* cur = g.load(ty, slot)
        var* nxt = g.inst("add " + lt + " " + cur + ", 1")
        g.store(ty, nxt, slot)
        g.br(condBB)
        g.label(endBB)
        g.popScope()
        return
    }
    var* seq = g.genExpr(s.Iterable, nil)
    if g.failed {
        return
    }
    if seq.T.Kind == KMap {
        g.genMapForIn(s, seq)
        return
    }
    var* elemTy *Type = nil
    var* n = ""
    var* data = ""
    if seq.T.Kind == KArray {
        elemTy = seq.T.Elem
        data = g.extract(seq.T, seq.V, 0)
        n = g.extract(seq.T, seq.V, 1)
    } else if seq.T.Kind == KString {
        elemTy = g.tt.charT
        data = seq.V
        var* n32 = g.callRt("pgt_strlen", "i32", "ptr", "ptr " + seq.V)
        n = g.inst("sext i32 " + n32 + " to i64")
    } else {
        g.fail("cannot iterate over " + seq.T.Name() + " (use an array, a string or a range a..b)", s.Iterable.Line, s.Iterable.Col)
        return
    }
    var* idx = g.entryAlloca(g.tt.int64T, "idx")
    g.store(g.tt.int64T, "0", idx)
    var* keySlot = ""
    if len(s.Key) > 0 {
        keySlot = g.newVarSlot(g.tt.intT, s.Key)
        g.declare(s.Key, &Var{Addr: keySlot, T: g.tt.intT, IsConst: false}, s.Line, s.Col)
    }
    var* valSlot = g.newVarSlot(elemTy, s.Val)
    g.store(elemTy, g.zeroValue(elemTy), valSlot)
    g.declare(s.Val, &Var{Addr: valSlot, T: elemTy, IsConst: false}, s.Line, s.Col)
    g.br(condBB)
    g.label(condBB)
    var* i = g.load(g.tt.int64T, idx)
    var* c = g.inst("icmp slt i64 " + i + ", " + n)
    g.condBr(c, bodyBB, endBB)
    g.label(bodyBB)
    if len(keySlot) > 0 {
        var* k = g.inst("trunc i64 " + i + " to i32")
        g.store(g.tt.intT, k, keySlot)
    }
    var* ep = g.inst("getelementptr " + g.llvmType(elemTy) + ", ptr " + data + ", i64 " + i)
    g.store(elemTy, g.load(elemTy, ep), valSlot)
    g.loops = append(g.loops, &LoopTarget{Continue: postBB, Break: endBB})
    g.genBlock(s.Body)
    g.loops = g.loops[0:len(g.loops) - 1]
    g.br(postBB)
    g.label(postBB)
    var* cur = g.load(g.tt.int64T, idx)
    var* nxt = g.inst("add i64 " + cur + ", 1")
    g.store(g.tt.int64T, nxt, idx)
    g.br(condBB)
    g.label(endBB)
    g.popScope()
}

fn (g *Gen) genSwitch(s *ast.Stmt) {
    if s.TypeSwitch {
        g.genTypeSwitch(s)
        return
    }
    var* endBB = g.newLabel("switch.end")
    g.pushScope()
    var* tag = Value{}
    if s.Tag != nil {
        tag = g.genExpr(s.Tag, nil)
        if g.failed {
            return
        }
        if tag.T.Kind == KVoid || tag.T.Kind == KNil {
            g.fail("cannot switch on " + tag.T.Name(), s.Tag.Line, s.Tag.Col)
            return
        }
    }
    var* bodies + {[]string} = []
    for c in s.Cases {
        bodies = append(bodies, g.newLabel("case.body"))
    }
    var* defaultBB = endBB
    if s.HasDefault {
        defaultBB = g.newLabel("switch.default")
    }
    for i, c in s.Cases {
        for ve in c.Values {
            var* cond = Value{}
            if s.Tag != nil {
                var* v = g.genExpr(ve, tag.T)
                if g.failed {
                    return
                }
                cond = g.compareValues(ast.BinEq, tag, v, ve.Line, ve.Col)
            } else {
                cond = g.genCond(ve)
            }
            if g.failed {
                return
            }
            var* next = g.newLabel("case.next")
            g.condBr(cond.V, bodies[i], next)
            g.label(next)
        }
    }
    g.br(defaultBB)
    g.loops = append(g.loops, &LoopTarget{Continue: "", Break: endBB})
    for i, c in s.Cases {
        g.label(bodies[i])
        g.genBlock(c.Body)
        g.br(endBB)
    }
    if s.HasDefault {
        g.label(defaultBB)
        g.genBlock(s.Default)
        g.br(endBB)
    }
    g.loops = g.loops[0:len(g.loops) - 1]
    g.label(endBB)
    g.popScope()
}
