package main

#use "fmt"
#use "os"
#use "strings"
#use "compiler/token"
#use "compiler/lexer"
#use "compiler/parser"
#use "compiler/dump"

fn tokensJson(toks []token.Token) string {
    var* b strings.Builder
    b.Write("[")
    var* first = true
    for t in toks {
        if !first {
            b.Write(",")
        }
        first = false
        b.Write("{\"kind\":")
        dump.JsonString(&b, token.KindName(t.Kind))
        b.Write(",\"text\":")
        dump.JsonString(&b, t.Text)
        b.Write(",\"line\":" + t.Line + ",\"col\":" + t.Col + "}")
    }
    b.Write("]")
    return b.String()
}

fn usage() {
    fmt.Println("usage: compiler <command> [args]")
    fmt.Println("")
    fmt.Println("commands:")
    fmt.Println("  tokens <file.pgt>   print the tokens of a file as JSON")
    fmt.Println("  ast <file.pgt>      print the syntax tree of a file as JSON")
    fmt.Println("  debug <file.pgt>    print tokens, syntax tree and error as one JSON document")
    fmt.Println("  help                show this message")
}

fn runTokens(path string) int {
    if !os.Exists(path) {
        fmt.Println(path + ": error: cannot read the file")
        return 1
    }
    var* src = os.ReadFile(path)
    var* toks, err = lexer.Tokenize(src)
    if len(err.Msg) > 0 {
        fmt.Println(path + ":" + err.Line + ":" + err.Col + ": error: " + err.Msg)
        return 1
    }
    fmt.Println(tokensJson(toks))
    return 0
}

fn readSource(path string) (string, bool) {
    if !os.Exists(path) {
        fmt.Println(path + ": error: cannot read the file")
        return "", false
    }
    return os.ReadFile(path), true
}

fn errorLine(path string, line int, col int, msg string) string {
    return path + ":" + line + ":" + col + ": error: " + msg
}

fn runAst(path string) int {
    var* src, ok = readSource(path)
    if !ok {
        return 1
    }
    var* toks, lerr = lexer.Tokenize(src)
    if len(lerr.Msg) > 0 {
        fmt.Println(errorLine(path, lerr.Line, lerr.Col, lerr.Msg))
        return 1
    }
    var* prog, perr = parser.Parse(toks)
    if len(perr.Msg) > 0 {
        fmt.Println(errorLine(path, perr.Line, perr.Col, perr.Msg))
        return 1
    }
    fmt.Println(dump.AstJson(prog))
    return 0
}

fn errorJson(b *strings.Builder, msg string, line int, col int) {
    b.Write(",\"error\":{\"message\":")
    dump.JsonString(b, msg)
    b.Write(",\"line\":" + line + ",\"col\":" + col + "}")
}

fn runDebug(path string) int {
    var* src, ok = readSource(path)
    if !ok {
        return 1
    }
    var* b strings.Builder
    b.Write("{\"files\":[{\"file\":")
    dump.JsonString(&b, path)
    b.Write(",\"tokens\":")
    var* toks, lerr = lexer.Tokenize(src)
    var* code = 0
    if len(lerr.Msg) > 0 {
        b.Write("[]")
        errorJson(&b, lerr.Msg, lerr.Line, lerr.Col)
        code = 1
    } else {
        b.Write(tokensJson(toks))
        var* prog, perr = parser.Parse(toks)
        if len(perr.Msg) > 0 {
            errorJson(&b, perr.Msg, perr.Line, perr.Col)
            code = 1
        } else {
            b.Write(",\"ast\":")
            b.Write(dump.AstJson(prog))
        }
    }
    b.Write("}]}")
    fmt.Println(b.String())
    return code
}

fn run() int {
    var* args = os.Args()
    if len(args) < 2 {
        usage()
        return 1
    }
    var* cmd = args[1]
    if cmd == "help" || cmd == "--help" || cmd == "-h" {
        usage()
        return 0
    }
    if cmd == "tokens" {
        if len(args) != 3 {
            usage()
            return 1
        }
        return runTokens(args[2])
    }
    if cmd == "ast" || cmd == "debug" {
        if len(args) != 3 {
            usage()
            return 1
        }
        if cmd == "ast" {
            return runAst(args[2])
        }
        return runDebug(args[2])
    }
    fmt.Println("compiler: unknown command '" + cmd + "'")
    usage()
    return 1
}

fn main() {
    os.Exit(run())
}

return 0
