package main

#use (
    "fmt"
    "os"
    "strings"
    "compiler/token"
    "compiler/lexer"
    "compiler/parser"
    "compiler/dump"
    "compiler/driver"
)

fn tokensJson(toks []token.Token) string {
    var* b strings.Builder
    b.Write("[")
    var* first = true
    for t in toks {
        if !first {
            b.Write(",")
        }
        first = false
        b.Write("{\"kind\":")
        dump.JsonString(&b, token.KindName(t.Kind))
        b.Write(",\"text\":")
        dump.JsonString(&b, t.Text)
        b.Write(",\"line\":" + t.Line + ",\"col\":" + t.Col + "}")
    }
    b.Write("]")
    return b.String()
}

fn usageLines() []string {
    return [
        "usage: compiler <command> [args]",
        "",
        "commands:",
        "  new <name> [-t <template>]       create a project (default template: hello)",
        "  new --list                       list project templates",
        "  build [dir|file.pgt] [-o <out>]  compile a package (default: .)",
        "  run [dir|file.pgt] [-- args...]  build, run and delete the program",
        "  build [dir|file.pgt] --emit-ir   write LLVM IR (.ll) instead",
        "  build|run [...] -O0|-O1|-O2|-O3  optimization level (default -O0)",
        "  tokens <file.pgt>                print the tokens of a file as JSON",
        "  ast <file.pgt>                   print the syntax tree of a file as JSON",
        "  debug <file.pgt>                 print tokens, syntax tree and error as one JSON document",
        "  help                             show this message"
    ]
}

fn usage() {
    for l in usageLines() {
        fmt.Println(l)
    }
}

fn usageErr() {
    for l in usageLines() {
        fmt.Eprintln(l)
    }
}

fn runTokens(path string) int {
    if !os.Exists(path) {
        fmt.Eprintln(path + ": error: cannot read the file")
        return 1
    }
    var* src = os.ReadFile(path)
    var* toks, err = lexer.Tokenize(src)
    if len(err.Msg) > 0 {
        fmt.Eprintln(path + ":" + err.Line + ":" + err.Col + ": error: " + err.Msg)
        return 1
    }
    fmt.Println(tokensJson(toks))
    return 0
}

fn readSource(path string) (string, bool) {
    if !os.Exists(path) {
        fmt.Eprintln(path + ": error: cannot read the file")
        return "", false
    }
    return os.ReadFile(path), true
}

fn errorLine(path string, line int, col int, msg string) string {
    return path + ":" + line + ":" + col + ": error: " + msg
}

fn runAst(path string) int {
    var* src, ok = readSource(path)
    if !ok {
        return 1
    }
    var* toks, lerr = lexer.Tokenize(src)
    if len(lerr.Msg) > 0 {
        fmt.Eprintln(errorLine(path, lerr.Line, lerr.Col, lerr.Msg))
        return 1
    }
    var* prog, perr = parser.Parse(toks)
    if len(perr.Msg) > 0 {
        fmt.Eprintln(errorLine(path, perr.Line, perr.Col, perr.Msg))
        return 1
    }
    fmt.Println(dump.AstJson(prog))
    return 0
}

fn errorJson(b *strings.Builder, msg string, line int, col int) {
    b.Write(",\"error\":{\"message\":")
    dump.JsonString(b, msg)
    b.Write(",\"line\":" + line + ",\"col\":" + col + "}")
}

fn runDebug(path string) int {
    var* src, ok = readSource(path)
    if !ok {
        return 1
    }
    var* b strings.Builder
    b.Write("{\"files\":[{\"file\":")
    dump.JsonString(&b, path)
    b.Write(",\"tokens\":")
    var* toks, lerr = lexer.Tokenize(src)
    var* code = 0
    if len(lerr.Msg) > 0 {
        b.Write("[]")
        errorJson(&b, lerr.Msg, lerr.Line, lerr.Col)
        code = 1
    } else {
        b.Write(tokensJson(toks))
        var* prog, perr = parser.Parse(toks)
        if len(perr.Msg) > 0 {
            errorJson(&b, perr.Msg, perr.Line, perr.Col)
            code = 1
        } else {
            b.Write(",\"ast\":")
            b.Write(dump.AstJson(prog))
        }
    }
    b.Write("}]}")
    fmt.Println(b.String())
    return code
}

fn runBuild(args []string, first int, isRun bool) int {
    var* opts = driver.BuildOptions{Input: "", Output: "", Run: isRun, EmitIr: false, OptLevel: 0}
    var* i = first
    while i < len(args) {
        var* a = args[i]
        if isRun && a == "--" {
            i++
            while i < len(args) {
                opts.RunArgs = append(opts.RunArgs, args[i])
                i++
            }
            break
        }
        if isRun && (a == "-o" || a == "--emit-ir") {
            fmt.Eprintln("pgt: error: '" + a + "' cannot be used with 'pgt run'")
            return 1
        }
        if a == "-o" {
            i++
            if i >= len(args) {
                fmt.Eprintln("pgt: error: '-o' needs an argument")
                return 1
            }
            opts.Output = args[i]
        } else if a == "-O0" || a == "-O1" || a == "-O2" || a == "-O3" {
            opts.OptLevel = int(a[2]) - 48
        } else if a == "--emit-ir" {
            opts.EmitIr = true
        } else if len(a) > 0 && a[0] == '-' {
            fmt.Eprintln("pgt: error: unknown option '" + a + "'")
            return 1
        } else if len(opts.Input) == 0 {
            opts.Input = a
        } else {
            fmt.Eprintln("pgt: error: more than one input file")
            return 1
        }
        i++
    }
    if len(opts.Input) == 0 {
        opts.Input = "."
    }
    return driver.Build(&opts)
}

fn runNew(args []string) int {
    var* name = ""
    var* templateName = "hello"
    var* i = 2
    while i < len(args) {
        var* a = args[i]
        if a == "--list" {
            driver.ListTemplates()
            return 0
        }
        if a == "-t" || a == "--template" {
            i++
            if i >= len(args) {
                fmt.Eprintln("pgt: error: '" + a + "' needs a template name")
                return 1
            }
            templateName = args[i]
        } else if len(a) > 0 && a[0] == '-' {
            fmt.Eprintln("pgt: error: unknown option '" + a + "'")
            return 1
        } else if len(name) == 0 {
            name = a
        } else {
            fmt.Eprintln("pgt: error: more than one project name")
            return 1
        }
        i++
    }
    if len(name) == 0 {
        fmt.Eprintln("pgt: error: usage: pgt new <name> [-t <template>]")
        return 1
    }
    return driver.New(name, templateName)
}

fn run() int {
    var* args = os.Args()
    if len(args) < 2 {
        usageErr()
        return 1
    }
    var* cmd = args[1]
    if cmd == "help" || cmd == "--help" || cmd == "-h" {
        usage()
        return 0
    }
    if cmd == "build" {
        return runBuild(args, 2, false)
    }
    if cmd == "run" {
        return runBuild(args, 2, true)
    }
    if cmd == "new" {
        return runNew(args)
    }
    if cmd == "tokens" {
        if len(args) != 3 {
            usageErr()
            return 1
        }
        return runTokens(args[2])
    }
    if cmd == "ast" || cmd == "debug" {
        if len(args) != 3 {
            usageErr()
            return 1
        }
        if cmd == "ast" {
            return runAst(args[2])
        }
        return runDebug(args[2])
    }
    if len(cmd) > 0 && cmd[0] != '-' && os.Exists(cmd) {
        return runBuild(args, 1, false)
    }
    fmt.Eprintln("compiler: unknown command '" + cmd + "'")
    usageErr()
    return 1
}

fn main() {
    os.Exit(run())
}

return 0
