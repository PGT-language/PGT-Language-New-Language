package render

#use (
    "shapes/geom"
    "strings"
    "conv"
    "fmt"
)

fn Describe(s geom.Shape) string {
    return strings.PadRight(s.Name(), 10, '.') + " " + conv.FormatFloat(s.Area(), 2)
}

fn Report(all []geom.Shape) {
    for i, s in all {
        fmt.Println(i + 1, ". ", Describe(s))
    }
    fmt.Println("total: ", conv.FormatFloat(geom.Total(all), 2))
}
