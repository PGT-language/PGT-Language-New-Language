package main

#use (
    "fmt"
    "c"
)

fn main() {
    c.Puts("puts line")
    c.Printf("printf plain\n")
    c.PrintfInt("int %d\n", 42)
    c.PrintfInt64("int64 %ld\n", int64(1) << 40)
    c.PrintfStr("str %s\n", "hello")
    c.PrintfFloat("float %.2f\n", 3.14159)
    c.PrintfIntInt("%d-%d\n", 3, 4)
    c.PrintfStrInt("%s=%d\n", "n", 7)
    c.Putchar(int('x'))
    c.Putchar(10)
    fmt.Println(c.SprintfInt("[%05d]", 42), " ", c.SprintfStr("<%s>", "ab"), " ", c.SprintfFloat("%.3f", 2.0), " ", c.SprintfInt64("%ld", int64(7)))

    var* path = "/tmp/pgt_c_bindings_test.txt"
    var* f = c.Fopen(path, "w")
    c.Fputs("line one\n", f)
    c.FprintfInt(f, "n=%d\n", 5)
    c.Fputc(int('z'), f)
    c.Fclose(f)
    var* g = c.Fopen(path, "r")
    var* buf = c.Calloc(1, 64)
    var* got = c.Fgets(buf, 64, g)
    fmt.Println(c.IsNil(got), " ", c.GoString(buf), c.Strlen(buf))
    var* n = c.Fread(buf, 1, 63, g)
    fmt.Println(n, " ", c.Feof(g))
    c.Fclose(g)
    var* fd = c.Open(path, c.O_RDONLY, 0)
    var* size = c.Lseek(fd, 0, c.SeekEnd)
    c.Lseek(fd, 5, c.SeekSet)
    var* m = c.Read(fd, buf, 3)
    fmt.Println(size, " ", m, " ", substr(c.GoString(buf), 0, 3))
    c.Close(fd)
    c.Rename(path, path + ".2")
    fmt.Println(c.Remove(path), " ", c.Remove(path + ".2"))
    var* none = c.Fopen("/nonexistent/dir/file", "r")
    fmt.Println(c.IsNil(none), " ", c.Errno() == c.ENOENT, " ", c.Strerror(c.ENOENT))
    c.SetErrno(c.EINVAL)
    fmt.Println(c.Errno())

    fmt.Println(c.Atoi("123"), " ", c.Atol("-9000000000"), " ", c.Atof("2.5"), " ", c.Strtol("ff", 16), " ", c.Strtod("1.5e2"), " ", c.Abs(-5), " ", c.Labs(int64(-6)))
    c.Setenv("PGT_C_TEST", "value", true)
    fmt.Println(c.Getenv("PGT_C_TEST"))
    c.Unsetenv("PGT_C_TEST")
    c.Srand(1)
    var* r1 = c.Rand()
    c.Srand(1)
    fmt.Println(r1 == c.Rand())

    var* a = c.Malloc(16)
    c.Strcpy(a, "abc")
    c.Strcat(a, "def")
    fmt.Println(c.GoString(a), " ", c.Strlen(a), " ", c.Strcmp("a", "b") < 0, " ", c.Strncmp("abcd", "abcf", 3), " ", c.GoString(c.Strchr("hello", int('l'))), " ", c.GoString(c.Strrchr("hello", int('l'))), " ", c.GoString(c.Strstr("hello world", "o w")))
    var* b = c.Malloc(16)
    c.Memcpy(b, a, 7)
    c.Memset(a, 65, 3)
    fmt.Println(c.Memcmp(a, b, 3) != 0, " ", c.GoString(a), " ", c.GoString(b))
    c.Memmove(c.Add(b, 1), b, 3)
    fmt.Println(c.GoString(b))
    c.Free(a)
    c.Free(b)
    var* d = c.CString("dup")
    fmt.Println(c.GoString(d), " ", c.Strlen(c.CharPtr("four")))
    c.StoreInt(d, 1633837924)
    fmt.Println(c.LoadInt(d), " ", c.LoadByte(c.Add(d, 1)))
    c.Free(d)

    fmt.Println(c.Isalpha(int('a')), " ", c.Isdigit(int('a')), " ", c.Isspace(32), " ", c.Isupper(int('A')), " ", c.Islower(int('A')), " ", c.Ispunct(int('!')), " ", c.Isxdigit(int('f')), " ", c.Isalnum(int('_')), " ", c.Isprint(10), " ", char(c.Toupper(int('q'))), " ", char(c.Tolower(int('Q'))))
    fmt.Println(c.Sqrt(16.0), " ", c.Pow(2.0, 10.0), " ", c.Floor(2.7), " ", c.Ceil(2.1), " ", c.Fabs(-1.5), " ", c.Fmod(7.0, 4.0), " ", c.Hypot(3.0, 4.0), " ", c.Cbrt(27.0), " ", c.Log2(8.0), " ", c.Exp(0.0), " ", c.Atan2(0.0, 1.0))
    var* t0 = c.Time()
    c.Usleep(1000)
    c.Nanosleep(0, 1000000)
    fmt.Println(t0 > 1000000000, " ", c.Clock() >= 0, " ", c.Getpid() > 0, " ", c.Isatty(-1))
    c.Ignore(c.SIGUSR1)
    fmt.Println(c.Raise(c.SIGUSR1))
    c.Default(c.SIGUSR1)
    fmt.Println(c.SizeofLong, " ", c.SizeofPointer, " ", c.O_CREAT, " ", c.SIGINT)
}

return 0
