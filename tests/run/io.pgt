package main

#use (
    "fmt"
    "io"
    "strings"
)

fn main() {
    var* name = io.Prompt("name? ")
    fmt.Println("hi ", name)
    var* n = io.ReadInt("n? ")
    fmt.Println("n*2 = ", n * 2)
    var* rest = io.ReadLines()
    fmt.Println(len(rest), " more lines: ", rest)
    fmt.Println("upper: ", strings.Upper(strings.Join(rest, "|")), " eof=", io.EOF())
}

return 0
