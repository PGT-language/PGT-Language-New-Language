package main

#use "sort"
#use "fmt"

struct Pair {
    Key int
    Seq int
}

struct Pairs {
    P []Pair
}

fn (p Pairs) Len() int { return len(p.P) }
fn (p Pairs) Less(i int, j int) bool { return p.P[i].Key < p.P[j].Key }
fn (p Pairs) Swap(i int, j int) {
    var* t = p.P[i]
    p.P[i] = p.P[j]
    p.P[j] = t
}

struct Desc {
    A []int
}

fn (d Desc) Len() int { return len(d.A) }
fn (d Desc) Less(i int, j int) bool { return d.A[i] > d.A[j] }
fn (d Desc) Swap(i int, j int) {
    var* t = d.A[i]
    d.A[i] = d.A[j]
    d.A[j] = t
}

fn main() {
    var* seed = 12345
    var* big + {[]int} = []
    for i in 0..100000 {
        seed = (seed * 1103515245 + 12345) & 0x7fffffff
        big = append(big, seed % 1000000)
    }
    sort.Ints(big)
    fmt.Println("big sorted: ", sort.IntsAreSorted(big), " n=", len(big), " first=", big[0], " last=", big[99999])

    var* rev + {[]int} = []
    for i in 0..50000 {
        rev = append(rev, 50000 - i)
        big[i] = 7
    }
    sort.Ints(rev)
    sort.Ints(big)
    fmt.Println("reverse: ", sort.IntsAreSorted(rev), " ", rev[0], " ", rev[49999], " equal: ", sort.IntsAreSorted(big))

    var* pairs + {[]Pair} = []
    for i in 0..5000 {
        seed = (seed * 1103515245 + 12345) & 0x7fffffff
        pairs = append(pairs, Pair{Key: seed % 50, Seq: i})
    }
    sort.Stable(Pairs{P: pairs})
    var* stable = true
    for i in 1..len(pairs) {
        if pairs[i - 1].Key > pairs[i].Key {
            stable = false
        }
        if pairs[i - 1].Key == pairs[i].Key && pairs[i - 1].Seq > pairs[i].Seq {
            stable = false
        }
    }
    fmt.Println("stable: ", stable)

    var* d = [5, 2, 9, 1, 7, 3, 8, 3]
    sort.Sort(Desc{A: d})
    fmt.Println(d, " ", sort.IsSorted(Desc{A: d}), " ", sort.IsSorted(sort.IntSlice{A: d}))

    var* words = ["pear", "apple", "fig", "banana", "cherry"]
    sort.Strings(words)
    fmt.Println(words)
    fmt.Println(sort.SearchStrings(words, "cherry"), " ", sort.SearchStrings(words, "zzz"))

    var* fs = [3.5, -1.25, 2.0, 0.0]
    sort.Float64s(fs)
    fmt.Println(fs)

    var* i64 + {[]int64} = [5000000000, 3, -7]
    sort.Int64s(i64)
    fmt.Println(i64)

    var* nums = [1, 3, 3, 5, 9]
    fmt.Println(sort.SearchInts(nums, 3), " ", sort.SearchInts(nums, 4), " ", sort.SearchInts(nums, 10), " ", sort.SearchInts(nums, 0))

    var* empty + {[]int} = []
    sort.Ints(empty)
    fmt.Println(len(empty), " ", sort.IntsAreSorted(empty))
}

return 0
