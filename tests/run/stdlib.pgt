package main

#use (
    "fmt"
    "strings"
    "arrays"
    "math"
    "conv"
    "rand"
    "time"
    "os"
)

fn main() {
    fmt.Println("--- strings")
    var* parts = strings.Split("a,b,,c", ",")
    fmt.Println(parts, " ", len(parts))
    fmt.Println(strings.Join(parts, "+"))
    fmt.Println(strings.Fields("  hello   pgt  world "))
    fmt.Println("[", strings.TrimSpace("  x y  "), "] [", strings.Trim("--x--", "-"), "]")
    fmt.Println(strings.Replace("aaa", "a", "bb"), " ", strings.ReplaceN("aaa", "a", "b", 2))
    fmt.Println(strings.Repeat("ab", 3), " ", strings.Reverse("hello"), " ", strings.Title("hello big world"))
    fmt.Println(strings.Count("cheese", "e"), " ", strings.LastIndex("go gopher", "go"), " ", strings.IndexFrom("abcabc", "b", 2))
    fmt.Println("[", strings.PadLeft("7", 3, '0'), "] [", strings.PadRight("ab", 4, '.'), "] [", strings.Center("hi", 6, '*'), "]")
    fmt.Println(strings.HasPrefix("prefix", "pre"), " ", strings.TrimPrefix("prefix", "pre"), " ", strings.TrimSuffix("file.pgt", ".pgt"))
    fmt.Println(strings.IsDigit('7'), " ", strings.IsLetter('7'), " ", strings.ToUpper('q'), " ", strings.EqualFold("PgT", "pgt"))
    fmt.Println(strings.Lines("one\ntwo\r\nthree\n"))
    var* b strings.Builder
    for i in 0..5 {
        b.Write(str(i))
        b.WriteChar('-')
    }
    fmt.Println(b.String(), " len=", b.Len())

    fmt.Println("--- math")
    fmt.Println(math.Pi, " ", math.E, " ", math.MaxInt, " ", math.MinInt, " ", math.MaxInt64)
    fmt.Println(math.Cbrt(27), " ", math.Hypot(3, 4), " ", math.Atan2(1, 1) * 4, " ", math.Log10(1000), " ", math.Log2(8))
    fmt.Println(math.PowInt(2, 62), " ", math.Gcd(84, 36), " ", math.Lcm(4, 6), " ", math.Factorial(20), " ", math.Fib(90))
    fmt.Println(math.IsPrime(97), " ", math.IsPrime(91), " ", math.Clamp(5.5, 0, 1), " ", math.Round(2.5), " ", math.Mod(7.5, 2))
    fmt.Println(math.IsNaN(math.NaN()), " ", math.IsInf(math.Inf()), " ", math.Sign(-2.5), " ", math.Degrees(math.Pi), " ", math.DigitSum(-1234))

    fmt.Println("--- arrays")
    var* a = [5, 3, 9, 1, 7, 3, 8, 2, 6, 4, 0, 11, 15, 13, 12, 14, 10, 19, 17, 16, 18, 3]
    arrays.Sort(a)
    fmt.Println(a, " sorted=", arrays.IsSorted(a))
    fmt.Println(arrays.Sum(a), " ", arrays.Min(a), " ", arrays.Max(a), " ", arrays.Mean([1, 2]), " ", arrays.Count(a, 3))
    fmt.Println(arrays.BinarySearch(a, 13), " ", arrays.BinarySearch(a, 42), " ", arrays.Unique([1, 2, 1, 3, 2]))
    var* r = arrays.Range(0, 5)
    arrays.Reverse(r)
    fmt.Println(r, " ", arrays.Slice(r, 1, 3), " ", arrays.Concat([1], [2, 3]), " ", arrays.Repeat(7, 3))
    var* words = ["pear", "apple", "fig", "banana"]
    arrays.SortStrings(words)
    fmt.Println(words, " ", arrays.ContainsString(words, "fig"))
    var* fs = [2.5, 1.5, 3.0]
    arrays.SortFloat(fs)
    fmt.Println(fs, " ", arrays.MeanFloat(fs))

    fmt.Println("--- conv")
    fmt.Println(conv.Itoa(42) + "!", " ", conv.Atoi("-17") * 2, " ", conv.ParseBool("yes"), " ", conv.IsInt(" 12 "), " ", conv.IsInt("12a"), " ", conv.IsFloat("1e3"))
    fmt.Println(conv.FormatFloat(math.Pi, 3), " ", conv.ToBinary(10), " ", conv.ToHex(255), " ", conv.FormatInt(-35, 36), " ", conv.ParseIntBase("ff", 16), " ", conv.ParseIntBase("-101", 2))

    fmt.Println("--- rand")
    rand.Seed(42)
    var* first = rand.Int()
    rand.Seed(42)
    fmt.Println("deterministic: ", first == rand.Int())
    var* ok = true
    for i in 0..1000 {
        var* d = rand.Range(1, 6)
        if d < 1 || d > 6 { ok = false }
        var* f = rand.Float()
        if f < 0.0 || f >= 1.0 { ok = false }
    }
    fmt.Println("ranges ok: ", ok)
    var* deck = arrays.Range(0, 10)
    rand.Shuffle(deck)
    arrays.Sort(deck)
    fmt.Println("shuffle keeps elements: ", arrays.Equal(deck, arrays.Range(0, 10)))

    fmt.Println("--- time / os")
    var* sw = time.StartStopwatch()
    time.Sleep(20)
    fmt.Println("slept enough: ", sw.ElapsedMs() >= 15, " year ok: ", len(time.Format(time.Now(), "%Y")) == 4)
    fmt.Println("args: ", os.NumArgs(), " ", os.Arg(1))
    var* path = "/tmp/pgt-stdlib-test.txt"
    os.WriteFile(path, "line1\nline2\n")
    os.AppendFile(path, "line3")
    fmt.Println(os.ReadLines(path), " exists=", os.Exists(path), " dir=", os.IsDir("/tmp"))
    os.Remove(path)
    fmt.Println("removed: ", !os.Exists(path), " HOME set: ", len(os.Getenv("HOME")) > 0)
}

return 0
