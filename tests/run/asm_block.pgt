package main

#use (
    "fmt"
    "asm"
)

struct Pair {
    A int64
    B int64
}

var* counter int64 = 100

fn addTen(v int) int {
    var* r = 0
    asm {
        mov eax, {v}
        add eax, 10
        mov {r}, eax
    }
    return r
}

fn sumTo(n int64) int64 {
    var* total int64 = 0
    asm {
        xor rax, rax
        mov rcx, {n}
    again:
        test rcx, rcx
        jz finished
        add rax, rcx
        dec rcx
        jmp again
    finished:
        mov {total}, rax
    }
    return total
}

fn clobber() int {
    var* keep1 = 11
    var* keep2 = 22
    var* keep3 int64 = 33
    var* out = 0
    asm {
        mov rbx, 1
        mov r12, 3
        mov r13, 4
        mov r14, 5
        mov rcx, 6
        mov rdx, 7
        mov esi, 8
        mov edi, 9
        mov eax, ebx
        add eax, r12d
        mov {out}, eax
    }
    return keep1 + keep2 + int(keep3) + out
}

fn main() {
    var* x = 5
    var* y = 0
    var* b byte = 250
    var* c char = 'a'
    var* t = true
    var* f = true
    var* big int64 = 1
    asm {
        mov eax, {x}
        add eax, 10
        mov {y}, eax
        add {b}, 10
        add {c}, 1
        mov {f}, 0
        mov rax, {big}
        shl rax, 40
        mov {big}, rax
    }
    fmt.Println(x, " ", y, " ", b, " ", c, " ", t, " ", f, " ", big)

    var* arr = make([]int64, 3)
    arr[0] = 1
    arr[1] = 2
    arr[2] = 3
    var* p = &arr[1]
    asm {
        mov rax, {p}
        mov qword ptr [rax], 42
    }
    fmt.Println(arr[0], " ", arr[1], " ", arr[2])

    var* pair = Pair{A: 1, B: 2}
    var* pb = &pair.B
    asm {
        mov rax, {pb}
        mov rcx, [rax]
        imul rcx, 21
        mov [rax], rcx
    }
    fmt.Println(pair.A, " ", pair.B)

    var* acc int64 = 0
    for i in 0..1000 {
        var* k = i
        var* add = 0
        asm {
            mov eax, {k}
            and eax, 7
            mov {add}, eax
        }
        acc += int64(add)
    }
    fmt.Println(acc)

    var* u = 1
    var* v = 2
    asm {
        mov eax, {u}
        add {v}, eax
    }
    asm {
        mov eax, {v}
        add {u}, eax
    }
    fmt.Println(u, " ", v)

    fmt.Println(addTen(5), " ", addTen(-20), " ", sumTo(100), " ", sumTo(0))
    fmt.Println(clobber())

    asm {
        mov rax, {counter}
        add rax, 23
        mov {counter}, rax
    }
    fmt.Println(counter)

    var* np *int64 = nil
    asm {
        mov rax, {np}
        test rax, rax
        setz al
        movzx eax, al
        mov {y}, eax
    }
    fmt.Println(y)
}

return 0
