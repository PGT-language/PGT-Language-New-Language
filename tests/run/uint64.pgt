package main

#use "fmt"

fn main() {
    var* a uint64 = 18446744073709551615
    fmt.Println(a)
    fmt.Println(str(a))
    var* b uint64 = a / 10
    fmt.Println(b, a % 10, a > b, a >> 60, b << 1)
    var* c uint64 = uint64(7) - 8
    fmt.Println(c)
    fmt.Printf("%d %v\n", c, c)
    var* n int64 = -1
    fmt.Println(uint64(n), int64(a), float(a) > 10000000000000000000.0)
    var* m = make(map[uint64]string)
    m[a] = "max"
    m[1] = "one"
    fmt.Println(m[a], m[1], len(m))
    var* arr []uint64 = [1, 2, a]
    fmt.Println(arr)
    fmt.Println(a == 18446744073709551615, a != b, min(a, b), max(a, b))
    var* big uint64 = 0xFFFFFFFFFFFFFFFF
    fmt.Println(big == a, uint64(5) * 3 / 2, uint64(255) & 15 | 64 ^ 1)
}

return 0
