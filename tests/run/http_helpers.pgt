package main

#use (
    "http"
    "fmt"
)

fn main() {
    fmt.Println(http.URLDecode("a%20b+c%C3%A9%zz%4", true))
    fmt.Println(http.URLDecode("a+b%2Fc", false))
    var* q = http.ParseQuery("name=P+G%54&x=1&name=2&e")
    fmt.Println(q["name"], "|", q["x"], "|", q["e"], "|", len(q))
    var* r, err = http.ParseHead("POST /a%20b?q=1&z=%41 HTTP/1.1\r\nHost: x\r\nX-Foo:  bar \r\nContent-Length: 4")
    fmt.Println(err, "|", r.Method, "|", r.Path, "|", r.Query("q"), "|", r.Query("z"), "|", r.Header("x-FOO"), "|", r.Header("CONTENT-length"))
    var* _, bad = http.ParseHead("garbage")
    fmt.Println(bad)
    var* res, e2 = http.ParseResponse("HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\n\r\nbody")
    fmt.Println(res.Status, res.Header("content-type"), res.Body, e2)
    var* chunked, e3 = http.ParseResponse("HTTP/1.1 404 Not Found\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n2\r\nde\r\n0\r\n\r\n")
    fmt.Println(chunked.Status, chunked.Body, e3)
    var* host, port, path, perr = http.ParseURL("http://localhost:8080/x?y=1")
    fmt.Println(host, port, path, perr)
    var* h2, p2, path2, perr2 = http.ParseURL("http://example.com")
    fmt.Println(h2, p2, path2, perr2)
    var* _, _, _, e4 = http.ParseURL("https://example.com/")
    fmt.Println(e4)
    fmt.Println(http.Mime("a/b.PNG"), "|", http.Mime("x.wasm"), "|", http.Mime("x.unknown"))
    fmt.Println(http.StatusText(404), "|", http.StatusText(403))
}
return 0
