package main

#use (
    "http"
    "fmt"
)

fn main() {
    fmt.Println(http.QueryUnescape("a%20b+c%C3%A9%zz%4"))
    fmt.Println(http.PathUnescape("a+b%2Fc"))
    fmt.Println(http.QueryEscape("a b/c&d=é~-_."), "|", http.PathEscape("a b"))
    var* q = http.ParseQuery("name=P+G%54&x=1&name=2&e")
    fmt.Println(q.Get("name"), "|", q.Get("x"), "|", q.Get("e") == "", "|", q.Has("e"), "|", len(q.All("name")))
    fmt.Println(http.Mime("a/b.PNG"), "|", http.Mime("x.wasm"), "|", http.Mime("x.unknown"))
    fmt.Println(http.StatusText(404), "|", http.StatusText(403), "|", http.StatusText(http.StatusSwitchingProtocols))
    var* h = http.NewHeader()
    h.Add("accept", "a")
    h.Add("Accept", "b")
    fmt.Println(h.Values("ACCEPT"), len(h.Keys()))
}
return 0
