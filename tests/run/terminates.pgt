package main

#use "fmt"

fn sign(n int) int {
    if n > 0 {
        return 1
    } else if n < 0 {
        return -1
    } else {
        return 0
    }
}

fn name(n int) string {
    switch n {
        case 1 {
            return "one"
        }
        case 2 {
            return "two"
        }
        default {
            return "many"
        }
    }
}

fn kind(v any) string {
    switch x = v.(type) {
        case int {
            return "int"
        }
        case string {
            return "string"
        }
        default {
            return "other"
        }
    }
}

fn nested(a int, b int) int {
    switch a {
        case 1 {
            switch b {
                case 1 {
                    return 11
                }
                default {
                    return 10
                }
            }
        }
        default {
            if b > 0 {
                return 1
            } else {
                return 2
            }
        }
    }
}

fn forever() int {
    var* i = 0
    while true {
        i++
        if i == 5 {
            return i
        }
    }
}

fn spin() int {
    for {
        return 7
    }
}

fn fail(code int) int {
    if code > 100 {
        panic("too big")
    } else {
        return code
    }
}

fn main() {
    fmt.Println(sign(5), " ", sign(-5), " ", sign(0))
    fmt.Println(name(1), " ", name(2), " ", name(9))
    fmt.Println(kind(1), " ", kind("s"), " ", kind(1.5))
    fmt.Println(nested(1, 1), " ", nested(1, 2), " ", nested(2, 1), " ", nested(2, -1))
    fmt.Println(forever(), " ", spin(), " ", fail(3))
}

return 0
