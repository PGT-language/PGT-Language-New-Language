{
  "scopeName": "source.pgt-mod",
  "patterns": [
    {
      "match": "//.*$",
      "name": "comment.line.double-slash.pgt"
    },
    {
      "match": "\\b(module|version|dependencies|target|entry|linker)\\b",
      "name": "keyword.control.pgt"
    },
    {
      "match": "\\b(kernel|hosted|true|false)\\b",
      "name": "constant.language.pgt"
    },
    {
      "match": "\"(?:[^\"\\\\]|\\\\.)*\"",
      "name": "string.quoted.double.pgt"
    },
    {
      "match": "\\b\\d+(\\.\\d+)*\\b",
      "name": "constant.numeric.pgt"
    }
  ]
}
