package pit

#use "pgt-os-test-kernel/ports"

var* ticks int64 = 0
var* tickHz = 100

fn Init(hz int) {
    tickHz = hz
    var* divisor = 1193182 / hz
    ports.Outb(0x43, 0x36)
    ports.Outb(0x40, divisor & 0xFF)
    ports.Outb(0x40, (divisor >> 8) & 0xFF)
}

fn Ticks() int64 {
    return ticks
}

fn TickHz() int {
    return tickHz
}

fn UptimeMs() int64 {
    return ticks * 1000 / int64(tickHz)
}

fn Tick() {
    ticks++
}
