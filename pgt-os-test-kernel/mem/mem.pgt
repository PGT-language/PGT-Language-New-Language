package mem

#use "c"

c {
    #include <stdint.h>

    uint8_t pgt_peek8(uint64_t a) { return *(volatile uint8_t *)a; }
    uint16_t pgt_peek16(uint64_t a) { return *(volatile uint16_t *)a; }
    uint32_t pgt_peek32(uint64_t a) { return *(volatile uint32_t *)a; }
    uint64_t pgt_peek64(uint64_t a) { return *(volatile uint64_t *)a; }
    void pgt_poke8(uint64_t a, uint8_t v) { *(volatile uint8_t *)a = v; }
    void pgt_poke16(uint64_t a, uint16_t v) { *(volatile uint16_t *)a = v; }
    void pgt_poke32(uint64_t a, uint32_t v) { *(volatile uint32_t *)a = v; }
    void pgt_poke64(uint64_t a, uint64_t v) { *(volatile uint64_t *)a = v; }
    void pgt_memfill(uint64_t a, int32_t v, uint64_t n)
    {
        volatile uint8_t *p = (volatile uint8_t *)a;
        for (uint64_t i = 0; i < n; i++)
            p[i] = (uint8_t)v;
    }
    void pgt_memmove(uint64_t dst, uint64_t src, uint64_t n)
    {
        volatile uint8_t *d = (volatile uint8_t *)dst;
        volatile uint8_t *s = (volatile uint8_t *)src;
        if (d < s)
            for (uint64_t i = 0; i < n; i++)
                d[i] = s[i];
        else
            while (n--)
                d[n] = s[n];
    }
}

extern fn pgt_peek8(a uint64) byte
extern fn pgt_peek16(a uint64) int
extern fn pgt_peek32(a uint64) int64
extern fn pgt_peek64(a uint64) uint64
extern fn pgt_poke8(a uint64, v byte)
extern fn pgt_poke16(a uint64, v int)
extern fn pgt_poke32(a uint64, v int64)
extern fn pgt_poke64(a uint64, v uint64)
extern fn pgt_memfill(a uint64, v int, n uint64)
extern fn pgt_memmove(dst uint64, src uint64, n uint64)

fn Peek8(addr uint64) byte {
    return pgt_peek8(addr)
}

fn Peek16(addr uint64) int {
    return pgt_peek16(addr)
}

fn Peek32(addr uint64) int64 {
    return pgt_peek32(addr)
}

fn Peek64(addr uint64) uint64 {
    return pgt_peek64(addr)
}

fn Poke8(addr uint64, value byte) {
    pgt_poke8(addr, value)
}

fn Poke16(addr uint64, value int) {
    pgt_poke16(addr, value)
}

fn Poke32(addr uint64, value int64) {
    pgt_poke32(addr, value)
}

fn Poke64(addr uint64, value uint64) {
    pgt_poke64(addr, value)
}

fn MemFill(addr uint64, value int, n uint64) {
    pgt_memfill(addr, value, n)
}

fn MemMove(dst uint64, src uint64, n uint64) {
    pgt_memmove(dst, src, n)
}
